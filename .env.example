# Local synthetic demo only. Provisioning creates secrets; never put secrets here.
SIEPMU_DATA_DIR=.data
SIEPMU_WEB_HOST=127.0.0.1
SIEPMU_WEB_PORT=8080
SIEPMU_CONTROL_HOST=127.0.0.1
SIEPMU_CONTROL_PORT=8081
SIEPMU_RELAY_HOST=127.0.0.1
SIEPMU_RELAY_PORT=8082
SIEPMU_CONTROL_URL=http://127.0.0.1:8081
SIEPMU_RELAY_URL=http://127.0.0.1:8082
# Network deployment: set HTTPS public origin and use an operator-managed TLS proxy.
# SIEPMU_PUBLIC_ORIGIN=https://siepmu.example.mil
# SIEPMU_RELAY_SECRET_FILE=/path/to/provisioned/relay.secret
