{
  "name": "syntriass-siepmu-demonstrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Synthetic-data SIEPMU-69 demonstrator with policy-epoch-bound release",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "start": "node scripts/start.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --experimental-test-coverage --test --test-concurrency=1",
    "security": "node scripts/security.mjs",
    "sbom": "node scripts/sbom.mjs",
    "build": "node scripts/build.mjs",
    "verify": "npm run check && npm run lint && npm run format:check && npm run typecheck && npm test && npm run security && npm run build && npm run sbom",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "tsc --project tsconfig.json",
    "release:package": "node scripts/release.mjs",
    "test:browser": "node apps/unit-client/browser-check.mjs",
    "demo": "node scripts/demo.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "playwright": "1.63.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
