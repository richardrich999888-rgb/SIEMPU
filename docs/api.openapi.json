  "components": {
    "securitySchemes": {
      "BearerSession": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque 15-minute session, memory-only client; possession alone does not authorize device-bound mutations."
      }
    },
    "schemas": {
      "Proof": {
        "type": "object",
        "required": ["challengeId", "signature"],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "signature": {
            "type": "string",
            "description": "Base64url P1363 ECDSA signature"
          }
        }
      },
      "Packet": {
        "type": "object",
        "required": ["payload", "signature", "keyId"],
        "properties": {
          "payload": {
            "type": "object"
          },
          "signature": {
            "type": "string"
          },
          "keyId": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "code"],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "Login": {
        "type": "object",
        "required": ["username", "password", "otp"],
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "writeOnly": true
          },
          "otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "writeOnly": true
          }
        }
      },
      "Challenge": {
        "type": "object",
        "required": ["purpose"],
        "properties": {
          "purpose": {
            "enum": ["enroll", "bind", "operation"]
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "operation": {
            "type": "string"
          },
          "requestHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Required for enroll and operation. SHA256 of canonical exact body excluding proof fields."
          }
        }
      },
      "Mutation": {
        "type": "object",
        "required": ["proof"],
        "properties": {
          "proof": {
            "$ref": "#/components/schemas/Proof"
          }
        }
      },
      "Claim": {
        "type": "object",
        "required": ["proof", "expectedEpoch"],
        "properties": {
          "proof": {
            "$ref": "#/components/schemas/Proof"
          },
          "expectedEpoch": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Policy": {
        "type": "object",
        "required": ["proof", "fromUnit", "toUnit", "missionId", "allow"],
        "properties": {
          "proof": {
            "$ref": "#/components/schemas/Proof"
          },
          "fromUnit": {
            "type": "string",
            "format": "uuid"
          },
          "toUnit": {
            "type": "string",
            "format": "uuid"
          },
          "missionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,80}$"
          },
          "allow": {
            "type": "boolean"
          }
        }
      },
      "Submission": {
        "type": "object",
        "required": ["proof", "envelope", "signature", "ciphertext"],
        "properties": {
          "proof": {
            "$ref": "#/components/schemas/Proof"
          },
          "envelope": {
            "type": "object",
            "description": "Exact signed envelope in docs/protocols/IMPLEMENTATION_CONTRACT.md; includes wrapped key, never returned by listing endpoints."
          },
          "signature": {
            "type": "string"
          },
          "ciphertext": {
            "type": "string",
            "description": "Base64url AES-GCM payload; maximum 1MiB plus tag"
          }
        }
      }
    }
  }
}
