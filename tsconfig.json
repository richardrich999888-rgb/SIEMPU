{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "services/relay/auth.mjs",
    "services/relay/client.mjs",
    "packages/protocol/canonical.mjs",
    "packages/crypto/crypto.mjs",
    "packages/object-format/types.d.ts",
    "apps/unit-client/challenge.mjs",
    "apps/unit-client/authority-pin.mjs",
    "services/control/primitives.mjs",
    "services/control/build-info.mjs",
    "apps/unit-client/decisions.mjs",
    "apps/unit-client/capabilities.mjs"
  ]
}
