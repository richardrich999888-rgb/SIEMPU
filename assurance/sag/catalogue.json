{
  "schemaVersion": 1,
  "kind": "APPLICANT_CRYPTO_INVENTORY",
  "reviewDate": "2026-11-08",
  "coverage": "Reviewed application mechanisms and separately scoped laboratory/optional tools; not exhaustive discovery, cryptanalysis, an SBOM substitute or an agency decision.",
  "components": [
    {
      "id": "CR-01",
      "purpose": "Endpoint object confidentiality and authenticity",
      "mechanisms": [
        "P-256 ECDH",
        "HKDF-SHA256",
        "AES-256-GCM; 96-bit nonce and 128-bit tag",
        "ECDSA P-256 SHA-256; P1363"
      ],
      "boundary": "Sender and recipient endpoints",
      "deploymentScope": "APPLICATION",
      "custody": "Software endpoint keys; plaintext and recipient private key at endpoints",
      "limitations": "No forward secrecy for static recipient keys, hardware custody or agency qualification. Legacy v1 DMS integration remains a managed plaintext endpoint requiring explicit enablement. The v2 connector excludes plaintext, endpoint credentials and the wrapped content key; source encryption uses the existing provider. IAF-G05 deployment/migration qualification remains pending. Optional managed endpoint inspection uses SHA-256 byte binding, not scanner attestation or cryptographic grading; actual engine positive-path qualification and browser enforcement remain pending.",
      "sources": [
        "packages/crypto/crypto.mjs",
        "packages/protocol/canonical.mjs",
        "packages/integration/client.mjs",
        "services/integration/adapter.mjs",
        "services/integration/server.mjs",
        "packages/file-inspection/clamav.mjs"
      ],
      "tests": [
        "tests/crypto.test.mjs",
        "tests/crypto-provider.test.mjs",
        "tests/adapter-adversarial.test.mjs",
        "tests/file-inspection.test.mjs"
      ]
    },
    {
      "id": "CR-02",
      "purpose": "Encrypted endpoint vault",
      "mechanisms": [
        "PBKDF2-HMAC-SHA256; 600000 iterations; 32-byte salt",
        "AES-256-GCM; 12-byte IV; metadata AAD"
      ],
      "boundary": "Endpoint browser storage",
      "deploymentScope": "APPLICATION",
      "custody": "Passphrase-derived software key",
      "limitations": "Endpoint compromise, memory erasure and recovery need separate assessment.",
      "sources": ["packages/crypto/crypto.mjs"],
      "tests": ["tests/crypto.test.mjs"]
    },
    {
      "id": "CR-03",
      "purpose": "Personnel password and second factor",
      "mechanisms": [
        "scrypt N=16384 r=8 p=1; 16-byte salt; 32-byte output",
        "TOTP HMAC-SHA1; 6 digits; 30-second counter"
      ],
      "boundary": "Control authority",
      "deploymentScope": "APPLICATION",
      "custody": "Password hashes and encrypted TOTP seed",
      "limitations": "Phishing-resistant/hardware-backed login is not implemented. TOTP policy needs sponsor review.",
      "sources": ["services/control/primitives.mjs", "services/control/core.mjs"],
      "tests": ["tests/authority.test.mjs", "tests/additional-boundaries.test.mjs"]
    },
    {
      "id": "CR-04",
      "purpose": "Stored MFA seed protection",
      "mechanisms": ["AES-256-GCM; 12-byte random IV"],
      "boundary": "Authority storage",
      "deploymentScope": "APPLICATION",
      "custody": "Locally provisioned software master.key",
      "limitations": "No HSM, hardware attestation or physical tamper evaluation.",
      "sources": ["services/control/primitives.mjs", "scripts/bootstrap.mjs"],
      "tests": ["tests/authority.test.mjs"]
    },
    {
      "id": "CR-05",
      "purpose": "Sessions, device proof and operation binding",
      "mechanisms": [
        "32-byte random bearer token; SHA-256 lookup",
        "32-byte random challenge nonce",
        "ECDSA P-256 SHA-256"
      ],
      "boundary": "Authority and enrolled device",
      "deploymentScope": "APPLICATION",
      "custody": "Session database and endpoint software signing key",
      "limitations": "Historical NEXORA/login evidence is not a fresh authentication proof. IAF issuer/PKI mapping is outstanding.",
      "sources": [
        "services/control/core.mjs",
        "services/control/primitives.mjs",
        "apps/unit-client/challenge.mjs",
        "packages/integration/client.mjs",
        "services/integration/lifecycle.mjs"
      ],
      "tests": [
        "tests/authority.test.mjs",
        "tests/auth-routing.test.mjs",
        "tests/adapter-adversarial.test.mjs"
      ]
    },
    {
      "id": "CR-06",
      "purpose": "Decision evidence, checkpoint custody and monitoring signatures",
      "mechanisms": ["ECDSA P-256 SHA-256", "SHA-256 hash chain"],
      "boundary": "Authority, verifier, custodian and independent security collector",
      "deploymentScope": "APPLICATION",
      "custody": "Software signing key; separately trusted public key and retained checkpoint",
      "limitations": "Signatures do not establish human actions, trustworthy hardware or honest authority decisions. Collector detection and acknowledgement signatures do not establish complete event delivery, unique attack counts or append-only retention.",
      "sources": [
        "services/control/primitives.mjs",
        "services/evidence/custody.mjs",
        "apps/verifier/verify.mjs",
        "services/monitoring/collector.mjs",
        "services/monitoring/detections.mjs",
        "services/monitoring/exporter.mjs",
        "services/monitoring/server.mjs"
      ],
      "tests": [
        "tests/verifier-replay.test.mjs",
        "tests/checkpoint-custody.test.mjs",
        "tests/threat-detections.test.mjs"
      ]
    },
    {
      "id": "CR-07",
      "purpose": "Transport and service authentication",
      "mechanisms": [
        "TLS 1.3",
        "X.509 CA and hostname validation",
        "mTLS and SHA-256 certificate pins where configured"
      ],
      "boundary": "Service transport boundaries",
      "deploymentScope": "APPLICATION",
      "custody": "Laboratory software PKI; operator-supplied key/certificate files",
      "limitations": "Capture negotiated suites/groups, certificate algorithms and actual PKI on the agreed hardware.",
      "sources": [
        "packages/transport/tls.mjs",
        "deployment/secure/lab-pki.mjs",
        "deployment/secure/adapter-process.mjs"
      ],
      "tests": [
        "tests/transport/tls.test.mjs",
        "tests/transport/secure-stack.test.mjs",
        "tests/adapter-adversarial.test.mjs"
      ]
    },
    {
      "id": "CR-08",
      "purpose": "Provider selection, lifecycle and wrapping",
      "mechanisms": [
        "P-256 classical provider",
        "HKDF-SHA256; provider/suite/key/context domain binding",
        "AES-256-GCM key wrap"
      ],
      "boundary": "Endpoint provider engine",
      "deploymentScope": "APPLICATION",
      "custody": "Opaque software handles; no hardware token integrated",
      "limitations": "No supplied SAG-authorised module/SDK; content AEAD is fixed to AES-256-GCM. Configuration hash chain is not signed external attestation.",
      "sources": [
        "packages/crypto-provider/registry.mjs",
        "packages/crypto-provider/engine.mjs",
        "packages/crypto-provider/classical.mjs",
        "packages/crypto-provider/primitives.mjs",
        "services/crypto-policy/registry.mjs"
      ],
      "tests": [
        "tests/crypto-agility/providers.test.mjs",
        "tests/crypto-agility/wrap-derivation.test.mjs"
      ]
    },
    {
      "id": "CR-09",
      "purpose": "Signed offline distribution",
      "mechanisms": ["ECDSA P-256 SHA-256", "SHA-256 file/manifest digests"],
      "boundary": "Release signer and offline installer",
      "deploymentScope": "APPLICATION",
      "custody": "Independent release trust key and rollback ledger; software signer",
      "limitations": "Package integrity is distinct from grading and deployment authorisation.",
      "sources": ["packages/release/offline.mjs"],
      "tests": ["tests/offline-release.test.mjs"]
    },
    {
      "id": "CR-10",
      "purpose": "Laboratory post-quantum and hybrid candidates",
      "mechanisms": [
        "ML-KEM-768 and ML-KEM-1024",
        "ML-DSA-65",
        "X-Wing ML-KEM-768 + X25519",
        "HKDF-SHA256 and AES-256-GCM"
      ],
      "boundary": "Opt-in Node laboratory endpoints",
      "deploymentScope": "LAB_ONLY",
      "custody": "Software keys; Node/OpenSSL and pinned Noble laboratory dependency",
      "limitations": "Excluded from application releases. Algorithm standards and passing vectors do not establish implementation qualification.",
      "sources": [
        "packages/pqc-lab/native-provider.mjs",
        "packages/pqc-lab/xwing-provider.mjs",
        "packages/pqc-lab/envelope.mjs",
        "packages/pqc-lab/package-lock.json"
      ],
      "tests": [
        "tests/pqc/end-to-end.test.mjs",
        "packages/pqc-lab/laboratory.check.mjs",
        "assurance/kat/core/catalog.mjs"
      ]
    },
    {
      "id": "CR-11",
      "purpose": "Independent Rust evidence verifier",
      "mechanisms": ["ECDSA P-256 SHA-256; RustCrypto p256", "SHA-256"],
      "boundary": "Offline native verifier",
      "deploymentScope": "OPTIONAL_OFFLINE_TOOL",
      "custody": "Public verification keys only",
      "limitations": "Independent code is not independent institutional assessment. Native lockfile and target runtime need review.",
      "sources": [
        "native/evidence-verify/src/signature.rs",
        "native/evidence-verify/Cargo.toml",
        "native/Cargo.lock"
      ],
      "tests": ["tests/native/evidence-differential.check.mjs"]
    },
    {
      "id": "CR-12",
      "purpose": "VANIAN NEXORA evidence snapshots",
      "mechanisms": ["Ed25519 signed head", "SHA-256 domain-separated Merkle leaf"],
      "boundary": "Offline operator bridge",
      "deploymentScope": "OPTIONAL_OFFLINE_TOOL",
      "custody": "Software NEXORA signer; separate NEXORA and authority trust anchors",
      "limitations": "One-leaf snapshots; no live personnel authentication or continuous log. Upstream proprietary licensing retained.",
      "sources": [
        "integrations/nexora/src/lib.rs",
        "integrations/nexora/src/main.rs",
        "integrations/nexora/Cargo.toml",
        "integrations/nexora/Cargo.lock"
      ],
      "tests": ["integrations/nexora/tests/snapshot.rs", "tests/nexora/bridge.check.mjs"]
    },
    {
      "id": "CR-13",
      "purpose": "Application randomness",
      "mechanisms": [
        "Node randomBytes",
        "WebCrypto getRandomValues",
        "WebCrypto and OpenSSL key generation"
      ],
      "boundary": "Endpoint/server runtime and OS",
      "deploymentScope": "APPLICATION",
      "custody": "Runtime/OS CSPRNG; no independent physical entropy measurement",
      "limitations": "API use does not establish entropy-source validation, hardware provenance or module certification.",
      "sources": [
        "packages/crypto/crypto.mjs",
        "services/control/primitives.mjs",
        "services/control/core.mjs",
        "scripts/bootstrap.mjs"
      ],
      "tests": ["tests/crypto.test.mjs", "tests/authority.test.mjs"]
    },
    {
      "id": "CR-14",
      "purpose": "Authority-to-relay request authentication",
      "mechanisms": [
        "HMAC-SHA256 over method/path/body digest/time/nonce",
        "32-byte shared secret; 16-byte random request nonce",
        "Timestamp window and replay tracking"
      ],
      "boundary": "Control authority and ciphertext relay",
      "deploymentScope": "APPLICATION",
      "custody": "Locally provisioned software relay secret",
      "limitations": "Shared-key compromise permits forged relay requests; network replay control and deployed secret distribution need review. This does not authorise recipient key release.",
      "sources": [
        "services/relay/auth.mjs",
        "services/relay/server.mjs",
        "services/relay/client.mjs"
      ],
      "tests": ["services/relay/relay.test.mjs"]
    },
    {
      "id": "CR-15",
      "purpose": "Source-sealed document staging and outbox integrity",
      "mechanisms": [
        "ECDSA P-256 SHA-256; domain-separated transport manifest",
        "SHA-256 ciphertext and configuration digests",
        "HMAC-SHA256; independent 32-byte source outbox key; separate document/row domains"
      ],
      "boundary": "Source endpoint, ciphertext connector and normal authority admission",
      "deploymentScope": "APPLICATION",
      "custody": "Source retains encryption/signing keys, session, wrapped content key and outbox HMAC key. Connector has public source pin plus TLS and relay workload credentials only.",
      "limitations": "Synthetic interface and software key custody only; relay staging is not admission or release. Metadata remains visible, legacy stores need migration, and host isolation/real-interface acceptance remain pending.",
      "sources": [
        "packages/integration/sealed-transfer.mjs",
        "apps/document-system/sealed-outbox.mjs",
        "services/integration/sealed-adapter.mjs",
        "services/integration/sealed-server.mjs",
        "deployment/secure/sealed-adapter-process.mjs"
      ],
      "tests": ["tests/sealed-integration.test.mjs"]
    }
  ],
